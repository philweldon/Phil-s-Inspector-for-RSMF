<Window x:Class="Rsmf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phil's Inspector for RSMF files" Icon="brick.ico" Height="900" Width="1360" MinHeight="600" MinWidth="1040" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AllowDrop="True" PreviewDragOver="OnWindowDragOver" PreviewDrop="OnWindowDrop"
        Closing="OnWindowClosing">
    <DockPanel Margin="18,14,18,10">

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,2,4" />
            <StackPanel>
                <TextBlock Text="Phil's Inspector for RSMF files" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Local inspection and QC of Relativity Short Message Format files" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>

        <!-- Footer: note on the left, a small red brick in the corner -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Canvas x:Name="Brick" DockPanel.Dock="Right" Width="30" Height="20" Margin="12,0,0,0" VerticalAlignment="Bottom"
                    SnapsToDevicePixels="True" ToolTip="A small red brick.">
                <!-- studs -->
                <Rectangle Canvas.Left="4" Canvas.Top="1" Width="8" Height="5" RadiusX="1" RadiusY="1" Fill="#D32F2F" />
                <Rectangle Canvas.Left="18" Canvas.Top="1" Width="8" Height="5" RadiusX="1" RadiusY="1" Fill="#D32F2F" />
                <Rectangle Canvas.Left="5" Canvas.Top="1.5" Width="6" Height="1.2" Fill="#EF5350" />
                <Rectangle Canvas.Left="19" Canvas.Top="1.5" Width="6" Height="1.2" Fill="#EF5350" />
                <!-- body -->
                <Rectangle Canvas.Left="1" Canvas.Top="5" Width="28" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#D32F2F" />
                <Rectangle Canvas.Left="2" Canvas.Top="6" Width="26" Height="2" Fill="#EF5350" />
                <Rectangle Canvas.Left="2" Canvas.Top="16" Width="26" Height="2.5" Fill="#B71C1C" />
            </Canvas>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Drop a folder or an .rsmf file on this window to check it. Double-click a row to open the viewer. For local QC. No telemetry, tracking, or ads. Free and open source under the MIT License. Designed by Phil Weldon. Subject to verification by the user." />
        </DockPanel>

        <!-- Settings -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Expander x:Name="SettingsExpander" IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="Settings for the next scan" Style="{StaticResource SectionTitle}" />
                </Expander.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="RememberBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,0,0"
                              Checked="OnRememberChanged" Unchecked="OnRememberChanged"
                              Content="Remember these settings on this PC (kept in a small file in your Windows profile; the include option is never remembered)" />

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Time zone for calendar-day rule" Style="{StaticResource FieldLabel}" Margin="0,0,10,8" />
                    <ComboBox x:Name="ZoneBox" Grid.Row="0" Grid.Column="1" IsEditable="True" Margin="0,0,24,8"
                              ToolTip="IANA time zone used by Rule A. Defaults to this PC's zone." />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Time-window mode" Style="{StaticResource FieldLabel}" Margin="0,0,10,8" />
                    <ComboBox x:Name="ModeBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size threshold (GB)" Style="{StaticResource FieldLabel}" Margin="0,0,10,8" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,24,8">
                        <TextBlock DockPanel.Dock="Right" Text="GB   (1 GB = 1,073,741,824 bytes)" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox x:Name="SizeBox"
                                 ToolTip="A file larger than this raises L-SIZE-001. Default 2 GB (2,147,483,648 bytes). Decimals such as 1.5 are allowed." />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Participant warning threshold" Style="{StaticResource FieldLabel}" Margin="0,0,10,8" />
                    <TextBox x:Name="ParticipantBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"
                             ToolTip="Optional. Leave blank to report the participant count without a warning." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Report folder (optional)" Style="{StaticResource FieldLabel}"
                               ToolTip="Leave blank and the reports are written beside the folder you scan. Choose a folder here only if you want them somewhere else." />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,24,0">
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseOutput" Margin="8,0,0,0" />
                        <TextBox x:Name="OutputBox"
                                 ToolTip="Leave blank and the reports are written beside the folder you scan. Choose a folder here only if you want them somewhere else." />
                    </DockPanel>
                    <CheckBox x:Name="SensitiveBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                              Content="Include message bodies and personal values in reports (off by default)" />
                </Grid>
            </Expander>
        </Border>

        <!-- Actions and progress -->
        <DockPanel DockPanel.Dock="Top" Margin="0,12,0,0">
            <Button x:Name="ScanButton" DockPanel.Dock="Left" Content="Scan Folder..." Click="OnScanFolder" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="OpenButton" DockPanel.Dock="Left" Content="Open RSMF File..." Click="OnOpenFile" />
            <Button x:Name="SamplesButton" DockPanel.Dock="Left" Content="Try the samples" Click="OnTrySamples" Visibility="Collapsed"
                    ToolTip="Scan the sample files that came with the app: two clean files and one file for each rule. Uses time zone America/New_York and a participant threshold of 5, which the samples are built for." />
            <Button x:Name="PdfButton" DockPanel.Dock="Left" Content="Convert RSMF Folder to PDF..." Click="OnConvertPdf"
                    ToolTip="Make one PDF per RSMF file in a folder, as chat bubbles. Nothing that is not in the RSMF file is added to the pages. The PDFs go to a new folder beside the one you choose. They contain message text, names and inline pictures." />
            <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Cancel" Click="OnCancel" IsEnabled="False" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="300"
                       Foreground="{StaticResource TextSecondary}" Text="Ready." />
            <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" Margin="8,0,0,0" />
        </DockPanel>

        <!-- Summary cards -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,12,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="RSMF files checked" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="CardFilesValue" Style="{StaticResource CardValue}" Text="-" />
                    <TextBlock x:Name="CardFilesNote" Style="{StaticResource Caption}" Text="No scan yet" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Errors" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="CardErrorsValue" Style="{StaticResource CardValue}" Text="-" />
                    <TextBlock x:Name="CardErrorsNote" Style="{StaticResource Caption}" Text=" " TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Warnings" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="CardWarningsValue" Style="{StaticResource CardValue}" Text="-" />
                    <TextBlock x:Name="CardWarningsNote" Style="{StaticResource Caption}" Text=" " TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Time-window QC" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="CardTimeValue" Style="{StaticResource CardValue}" Text="-" />
                    <TextBlock x:Name="CardTimeNote" Style="{StaticResource Caption}" Text=" " TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Scan coverage" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="CardCoverageValue" Style="{StaticResource CardValue}" Text="-" />
                    <TextBlock x:Name="CardCoverageNote" Style="{StaticResource Caption}" Text=" " TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Last run output -->
        <DockPanel DockPanel.Dock="Top" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Last report folder" Style="{StaticResource FieldLabel}" />
            <Button x:Name="ShowFolderButton" DockPanel.Dock="Right" Content="Show in Explorer" Click="OnShowFolder" IsEnabled="False" Margin="8,0,0,0" />
            <TextBox x:Name="RunFolderBox" IsReadOnly="True" Background="#F9FAFB" />
        </DockPanel>

        <!-- Results: by file, and by rule across the whole scan -->
        <TabControl x:Name="ResultTabs" Margin="0,12,0,0">
            <TabItem x:Name="FilesTab" Header="Files">
                <DockPanel Background="#FFFFFF">
                    <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                        <TextBlock DockPanel.Dock="Left" Text="Show files with findings of category" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Left" Width="170" SelectionChanged="OnFilterChanged" />
                        <TextBlock DockPanel.Dock="Left" Text="severity" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                        <ComboBox x:Name="SeverityFilter" DockPanel.Dock="Left" Width="150" SelectionChanged="OnFilterChanged" />
                        <TextBlock x:Name="RowCountText" VerticalAlignment="Center" Margin="18,0,0,0" Style="{StaticResource Caption}" />
                    </DockPanel>

                    <DataGrid x:Name="ResultsGrid" BorderThickness="0,1,0,0" MouseDoubleClick="OnRowDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="300" />
                            <DataGridTemplateColumn Header="Status" Width="170" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="65" />
                            <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size}" Width="100" />
                            <DataGridTextColumn Header="Events" Binding="{Binding Events}" Width="65" />
                            <DataGridTextColumn Header="Messages" Binding="{Binding Messages}" Width="80" />
                            <DataGridTextColumn Header="Conversations" Binding="{Binding Conversations}" Width="105" />
                            <DataGridTextColumn Header="Participants" Binding="{Binding Participants}" Width="90" />
                            <DataGridTemplateColumn Header="Errors" Width="65" SortMemberPath="Errors">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Errors}" Foreground="{Binding ErrorsForeground}" FontWeight="{Binding ErrorsWeight}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Warnings" Width="80" SortMemberPath="Warnings">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Warnings}" Foreground="{Binding WarningsForeground}" FontWeight="{Binding WarningsWeight}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="50" />
                            <DataGridTextColumn Header="FORMAT" Binding="{Binding Format}" Width="75" />
                            <DataGridTextColumn Header="LIMIT" Binding="{Binding Limit}" Width="60" />
                            <DataGridTextColumn Header="LOCAL" Binding="{Binding Local}" Width="65" />
                            <DataGridTextColumn Header="INCOMPLETE" Binding="{Binding Incomplete}" Width="105" />
                            <DataGridTemplateColumn Header="Time window" Width="140" SortMemberPath="TimeWindow">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TimeWindowBackground}" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left"
                                                Visibility="{Binding TimeWindowVisibility}">
                                            <TextBlock Text="{Binding TimeWindow}" Foreground="{Binding TimeWindowForeground}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="ExplorerTab" Header="Findings by rule">
                <Grid Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" MinWidth="320" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="RuleGroupGrid" Grid.Column="0" BorderThickness="0" SelectionChanged="OnRuleGroupSelected">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="SeverityRank">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding SeverityBackground}" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Severity}" Foreground="{Binding SeverityForeground}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleNumber}" Width="60" />
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="55" />
                            <DataGridTextColumn Header="Findings" Binding="{Binding Findings}" Width="75" />
                            <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource CardBorder}" />
                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                            <StackPanel>
                                <TextBlock x:Name="ExplorerTitle" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"
                                           Text="Run a scan, then select a rule to see every file it affects." />
                                <StackPanel x:Name="ExplorerHelp" Visibility="Collapsed">
                                    <TextBlock Text="What it means" Style="{StaticResource Caption}" Margin="0,6,0,1" />
                                    <TextBlock x:Name="ExplorerMeaning" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="What to do" Style="{StaticResource Caption}" Margin="0,6,0,1" />
                                    <TextBlock x:Name="ExplorerFix" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="ExplorerEverywhere" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                               Margin="0,6,0,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="ExplorerTechnical" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock x:Name="ExplorerNote" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="Double-click a row to open that file at the affected record." />
                                    <TextBlock Margin="0,6,0,0">
                                        <Hyperlink Click="OnExplorerOpenGuide">How and why this rule is checked (Rule guide)</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="OccurrenceGrid" BorderThickness="0" MouseDoubleClick="OnOccurrenceDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding File}" Width="240" />
                                <DataGridTextColumn Header="Observed" Binding="{Binding Observed}" Width="280" />
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="220" />
                                <DataGridTextColumn Header="Record" Binding="{Binding RecordId}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="GuideTab" Header="Rule guide">
                <Grid Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" MinWidth="320" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                            <TextBlock DockPanel.Dock="Left" Text="Search the rules" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="GuideCategory" DockPanel.Dock="Right" Width="150" Margin="10,0,0,0" SelectionChanged="OnGuideFilterChanged" />
                            <TextBox x:Name="GuideSearch" TextChanged="OnGuideSearchChanged" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="GuideCount" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="10,5,10,6" />
                        <DataGrid x:Name="GuideGrid" BorderThickness="0,1,0,1" SelectionChanged="OnGuideRuleSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rule" Binding="{Binding RuleNumber}" Width="55" />
                                <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="SeverityRank">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding SeverityBackground}" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Severity}" Foreground="{Binding SeverityForeground}" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95" />
                                <DataGridTextColumn Header="What the rule flags" Binding="{Binding Problem}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource CardBorder}" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="#FAFBFC">
                        <StackPanel Margin="18,12,18,16">
                            <TextBlock x:Name="GuideTitle" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"
                                       Text="Select a rule to see what it checks, how, and why." />
                            <StackPanel x:Name="GuideBody" Visibility="Collapsed">
                                <TextBlock x:Name="GuideOrigin" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="What this rule flags" Style="{StaticResource Caption}" Margin="0,10,0,1" />
                                <TextBlock x:Name="GuideWhat" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="How it is checked" Style="{StaticResource Caption}" Margin="0,10,0,1" />
                                <TextBlock x:Name="GuideHow" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Why it matters" Style="{StaticResource Caption}" Margin="0,10,0,1" />
                                <TextBlock x:Name="GuideWhy" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="What to do when it appears" Style="{StaticResource Caption}" Margin="0,10,0,1" />
                                <TextBlock x:Name="GuideDo" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Where it comes from" Style="{StaticResource Caption}" Margin="0,10,0,1" />
                                <TextBlock x:Name="GuideNoLinks" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"
                                           Text="There is no Relativity page for this rule: it is this app's own check." />
                                <ItemsControl x:Name="GuideLinks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Hyperlink Click="OnGuideLinkClick" Tag="{Binding Url}"><Run Text="{Binding Label, Mode=OneWay}" /></Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                                <TextBox Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                         TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="GuideLinkNote" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="A link opens in your web browser. This app itself does not connect to the internet. The address is shown under each link so you can copy it instead." />
                                <TextBlock x:Name="GuideTechnical" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
