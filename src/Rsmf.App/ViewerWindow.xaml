<Window x:Class="Rsmf.App.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rsmf.App"
        Title="RSMF viewer" Icon="brick.ico" Height="800" Width="1240" MinHeight="480" MinWidth="820"
        Background="{StaticResource WindowBackground}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Loaded="OnLoaded" Closed="OnClosed" PreviewKeyDown="OnWindowPreviewKeyDown">
    <DockPanel>

        <Border x:Name="UnavailableBanner" DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#C8A600"
                BorderThickness="0,0,0,1" Padding="10,6" Visibility="Collapsed">
            <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,10,10,4" Padding="12,8">
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Text="Loading..." Foreground="{StaticResource TextPrimary}" />
        </Border>

        <TabControl x:Name="Tabs" Margin="10,6,10,10" IsEnabled="False">

            <TabItem Header="Conversations">
                <Grid Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="160" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ConversationList" Grid.Column="0" BorderThickness="0" Background="#FAFBFC"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnConversationChanged"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,6">
                                    <local:ChatText Text="{Binding Title}" TextElement.FontWeight="SemiBold" SingleLine="True" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource CardBorder}" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4">
                            <TextBlock DockPanel.Dock="Left" Text="Search" Style="{StaticResource FieldLabel}" />
                            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearSearch" Margin="6,0,0,0" />
                            <Button x:Name="NextMatchButton" DockPanel.Dock="Right" Content="Next" Click="OnNextMatch" IsEnabled="False"
                                    Margin="6,0,0,0" ToolTip="Next message with a match (Enter)" />
                            <Button x:Name="PreviousMatchButton" DockPanel.Dock="Right" Content="Previous" Click="OnPreviousMatch" IsEnabled="False"
                                    Margin="6,0,0,0" ToolTip="Previous message with a match (Shift+Enter)" />
                            <CheckBox x:Name="OnlyMatchesBox" DockPanel.Dock="Right" Content="Only matches" VerticalAlignment="Center"
                                      Margin="12,0,6,0" Checked="OnOnlyMatchesChanged" Unchecked="OnOnlyMatchesChanged"
                                      ToolTip="Hide messages that do not contain the search text" />
                            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown"
                                     ToolTip="Search message text, sender names and attachment names (Ctrl+F)" />
                        </DockPanel>
                        <TextBlock x:Name="MessageCountText" DockPanel.Dock="Top" Margin="10,0,10,6" Style="{StaticResource Caption}" />
                        <ListBox x:Name="MessageList" HorizontalContentAlignment="Stretch" BorderThickness="0,1,0,0"
                                 BorderBrush="{StaticResource CardBorder}" Background="#FFFFFF"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Background="Transparent" Padding="12,3">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#EEF4FE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.Resources>

                                <!-- day separator -->
                                <DataTemplate DataType="{x:Type local:DayVm}">
                                    <Border HorizontalAlignment="Center" Background="#ECEFF2" CornerRadius="10" Padding="12,3" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                                    </Border>
                                </DataTemplate>

                                <!-- join / leave / disclaimer / history -->
                                <DataTemplate DataType="{x:Type local:NoticeVm}">
                                    <local:ChatText Text="{Binding NoticeText}" HorizontalAlignment="Center" Centered="True" TextElement.FontStyle="Italic"
                                                    Foreground="{StaticResource TextSecondary}" TextElement.FontSize="12" Margin="40,2"
                                                    ToolTip="{Binding ToolTipText}" />
                                </DataTemplate>

                                <!-- message bubble -->
                                <DataTemplate DataType="{x:Type local:MessageVm}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding Alignment}" Margin="0,2">
                                        <Grid Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,8,0">
                                            <Border CornerRadius="16" Background="{Binding SenderBrush}">
                                                <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <Border Background="{Binding BubbleBackground}" BorderBrush="{Binding BubbleBorder}" BorderThickness="1"
                                                CornerRadius="18" Padding="14,9" MinWidth="180" MaxWidth="680" ToolTip="{Binding ToolTipText}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                               Foreground="{Binding BubbleSubtle}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                                    <local:ChatText Text="{Binding SenderName}" Term="{Binding SearchTerm}"
                                                                    Foreground="{Binding BubbleText}" TextElement.FontWeight="SemiBold" SingleLine="True" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding ReplyText}" Visibility="{Binding ReplyVisibility}"
                                                           Style="{StaticResource Caption}" Foreground="{Binding BubbleSubtle}" Margin="0,2,0,0" />
                                                <TextBlock Text="This message was deleted" Visibility="{Binding DeletedVisibility}" FontStyle="Italic"
                                                           Foreground="{Binding BubbleSubtle}" Margin="0,3,0,0" />
                                                <local:ChatText Text="{Binding DisplayBody}" Term="{Binding SearchTerm}"
                                                                Visibility="{Binding BodyVisibility}"
                                                                Foreground="{Binding BubbleText}" Margin="0,3,0,0" />
                                                <ItemsControl ItemsSource="{Binding Attachments}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,5,0,0">
                                                                <Border Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                                        CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                                    <local:ChatText Text="{Binding Label}" TextElement.FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                                                </Border>
                                                                <Image Source="{Binding Image}" Visibility="{Binding ImageVisibility}"
                                                                       MaxWidth="320" MaxHeight="240" Stretch="Uniform" StretchDirection="DownOnly"
                                                                       HorizontalAlignment="Left" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <WrapPanel Margin="0,6,0,0" Visibility="{Binding FooterVisibility}">
                                                    <ItemsControl ItemsSource="{Binding Reactions}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FFFFFF" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1"
                                                                        CornerRadius="9" Padding="7,1" Margin="0,0,5,0">
                                                                    <local:ChatText Text="{Binding}" TextElement.FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding EditedText}" Style="{StaticResource Caption}" Foreground="{Binding BubbleSubtle}" VerticalAlignment="Center" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Headers">
                <DataGrid x:Name="HeaderGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                        <DataGridTextColumn Header="Header" Binding="{Binding Name}" Width="240" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Extracted text">
                <TextBox x:Name="ExtractedTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" BorderThickness="0" />
            </TabItem>

            <TabItem Header="Raw manifest">
                <TextBox x:Name="ManifestBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                         BorderThickness="0" />
            </TabItem>

            <TabItem x:Name="FindingsTab" Header="Findings">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="FindingGrid" Grid.Row="0" BorderThickness="0" MouseDoubleClick="OnFindingDoubleClick"
                              SelectionChanged="OnFindingSelected">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding SeverityBackground}" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Severity}" Foreground="{Binding SeverityForeground}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleNumber}" Width="60" />
                            <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="340" />
                            <DataGridTextColumn Header="Observed" Binding="{Binding Observed}" Width="260" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="230" />
                            <DataGridTextColumn Header="Record" Binding="{Binding RecordId}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock x:Name="HelpTitle" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"
                                       Text="Select a finding to see what it means and what to do about it. Double-click to go to the affected record." />
                            <StackPanel x:Name="HelpBody" Visibility="Collapsed">
                                <TextBlock Text="What it means" Style="{StaticResource Caption}" Margin="0,8,0,1" />
                                <TextBlock x:Name="HelpMeaning" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="What to do" Style="{StaticResource Caption}" Margin="0,8,0,1" />
                                <TextBlock x:Name="HelpFix" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="HelpDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Margin="0,6,0,0">
                                    <Hyperlink Click="OnOpenRuleGuide">How and why this rule is checked (Rule guide in the main window)</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Metadata coverage">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CoverageGrid" Grid.Row="0" SelectionChanged="OnCoverageSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100" />
                            <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="240" />
                            <DataGridTextColumn Header="Requirement" Binding="{Binding Requirement}" Width="140" />
                            <DataGridTextColumn Header="Records" Binding="{Binding Records}" Width="70" />
                            <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="70" />
                            <DataGridTextColumn Header="Blank" Binding="{Binding Blank}" Width="70" />
                            <DataGridTextColumn Header="Populated" Binding="{Binding Populated}" Width="80" />
                            <DataGridTextColumn Header="Invalid" Binding="{Binding Invalid}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="AffectedCaption" Grid.Row="1" Margin="4,6,4,2" Foreground="#555"
                               Text="Select a field to list the affected records. Double-click an event record to go to it." />
                    <ListBox x:Name="AffectedList" Grid.Row="2" DisplayMemberPath="Display" MouseDoubleClick="OnAffectedDoubleClick" />
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
